{
  "version": 4,
  "configurations": [
    {
      "name": "UDK Win32",
      "includePath": [
        "${workspaceFolder}/Src/**",
        "${workspaceFolder}/Src/Core/Inc",
        "${workspaceFolder}/Src/Engine/Inc",
        "${workspaceFolder}/Src/GameFramework/Inc",
        "${workspaceFolder}/Src/UnrealEd/Inc",
        "${workspaceFolder}/Src/WinDrv/Inc",
        "${workspaceFolder}/Src/D3D9Drv/Inc",
        "${workspaceFolder}/Src/D3D11Drv/Inc",
        "${workspaceFolder}/Src/OpenGLDrv/Inc",
        "${workspaceFolder}/Src/IpDrv/Inc",
        "${workspaceFolder}/Src/OnlineSubsystemPC/Inc",
        "${workspaceFolder}/External/**",
        "${workspaceFolder}/External/IntelTBB-2.1/include",
        "${workspaceFolder}/External/FaceFX/FxSDK/Inc",
        "${workspaceFolder}/External/wxWidgets/include",
        "${workspaceFolder}/External/zlib/Src",
        "${workspaceFolder}/External/libPNG",
        "${workspaceFolder}/External/libogg-1.1.3/include",
        "${workspaceFolder}/External/libvorbis-1.1.2/include",
        "${workspaceFolder}/External/libffi",
        "${workspaceFolder}/External/Steamworks/sdk/public",
        "${env:DXSDK_DIR}Include",
        "${env:DXSDK_DIR}Include/d3dx11"
      ],
      "defines": [
        "WIN32",
        "_WIN32",
        "WINDOWS",
        "WITH_EDITOR=1",
        "WITH_SERVER_CODE=1",
        "WITH_STEAMWORKS=1",
        "UNICODE",
        "_UNICODE",
        "FINAL_RELEASE=0",
        "STATS=1",
        "_CRT_SECURE_NO_DEPRECATE",
        "_CRT_NONSTDC_NO_DEPRECATE"
      ],
      "intelliSenseMode": "windows-msvc-x86",
      "cppStandard": "c++03",
      "cStandard": "c89",
      "compilerPath": "C:/Program Files (x86)/Microsoft Visual Studio 9.0/VC/bin/cl.exe",
      "browse": {
        "path": [
          "${workspaceFolder}/Src",
          "${workspaceFolder}/External"
        ],
        "limitSymbolsToIncludedHeaders": false
      }
    },
    {
      "name": "UDK Win64",
      "includePath": [
        "${workspaceFolder}/Src/**",
        "${workspaceFolder}/Src/Core/Inc",
        "${workspaceFolder}/Src/Engine/Inc",
        "${workspaceFolder}/Src/GameFramework/Inc",
        "${workspaceFolder}/Src/UnrealEd/Inc",
        "${workspaceFolder}/Src/WinDrv/Inc",
        "${workspaceFolder}/Src/D3D9Drv/Inc",
        "${workspaceFolder}/Src/D3D11Drv/Inc",
        "${workspaceFolder}/External/**",
        "${workspaceFolder}/External/Steamworks/sdk/public",
        "${env:DXSDK_DIR}Include"
      ],
      "defines": [
        "WIN64",
        "_WIN64",
        "WIN32",
        "_WIN32",
        "WITH_EDITOR=1",
        "WITH_SERVER_CODE=1",
        "UNICODE",
        "_UNICODE",
        "FINAL_RELEASE=0"
      ],
      "intelliSenseMode": "windows-msvc-x64",
      "cppStandard": "c++03",
      "cStandard": "c89",
      "compilerPath": "C:/Program Files (x86)/Microsoft Visual Studio 9.0/VC/bin/x86_amd64/cl.exe"
    }
  ]
}
